# Master endpoint advertised to worker agents (LAN IP, not loopback)
CRAWLMESH_MASTER_URL=http://192.168.18.141:8000

# Pairing token shown in CrawlMesh GUI / GET /api/cluster
CRAWLMESH_TOKEN=

# Worker agent HTTP port and multiprocessing pool size
CRAWLMESH_PORT=8010
CRAWLMESH_POOL_SIZE=4

# Master-only overrides
# CRAWLMESH_PORT=8000
# CRAWLMESH_DISCOVERY_PORT=5599

